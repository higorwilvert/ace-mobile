{
  "expo": {
    "name": "ACE",
    "slug": "ace-mobile",
    "version": "0.1.0",
    "scheme": "ace",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.acematchmaking.mobile"
    },
    "android": {
      "package": "br.com.acematchmaking.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#f6f8fc",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f6f8fc"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "O ACE usa sua galeria para você escolher a foto de perfil."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0052be"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.br.com.acematchmaking.mobile",
          "bundleIdentifier": "br.com.acematchmaking.mobile.widgets"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
